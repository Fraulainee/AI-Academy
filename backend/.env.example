# ---- required in production ----
# Local development: use NODE_ENV=development and you can leave JWT_SECRET empty.
# On a server: NODE_ENV=production and a real JWT_SECRET (the server refuses to start with "change-me").
NODE_ENV=development
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Public origin(s) of the website, comma separated. Only needed if the frontend is on a DIFFERENT origin than the API.
CORS_ORIGIN=
PORT=4000

# ---- optional ----
# Anyone registering with one of these emails becomes an educator (Faculty Console access). Comma separated.
EDUCATOR_EMAILS=
# Folder of weekly lessons (week-01.md, week-02.md …). Edit/add files; no restart needed.
CONTENT_DIR=./content
# Colab notebooks (week-01.ipynb …) and the GitHub copy the "Open in Colab" buttons point to.
# Set COLAB_REPO= (empty) to show only the download button. The repo must be public, and the notebooks must be pushed to COLAB_BRANCH.
NOTEBOOKS_DIR=../notebooks
COLAB_REPO=Supervaise-Inc/AI-Academy
COLAB_BRANCH=main
# Where the JSON database file lives. Put it on a persistent disk/volume.
DATA_DIR=./data
# Serve the built frontend from this process (default: ../frontend/dist when it exists).
FRONTEND_DIST=../frontend/dist
# Cookie settings. Same-origin hosting: leave defaults. Split hosting over HTTPS: COOKIE_SAMESITE=none, COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=
# Set to "1" when running behind a reverse proxy (nginx, Render, Railway, Fly …) so secure cookies and rate limits work.
TRUST_PROXY=1
